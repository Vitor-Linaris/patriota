NODE_ENV=development
PORT=3005

# URL que o browser usa para chegar à API
NEXT_PUBLIC_API_URL=http://localhost:8585

# URL que o servidor Next.js usa para chegar à API (servidor-a-servidor dentro da rede docker)
INTERNAL_API_URL=http://api:8585

# ────────────────────────────────────────────────────────────────────────────
# Flags públicas de funcionalidades. Deixe vazio/false a menos que a
# funcionalidade correspondente esteja pronta. São NEXT_PUBLIC_*: ficam
# embutidas no pacote do cliente, por isso NÃO as use como fronteira de
# segurança. As permissões são sempre impostas no servidor.
# ────────────────────────────────────────────────────────────────────────────

# Motor de comentários (publicar, moderar, separador "Mais Comentadas").
NEXT_PUBLIC_FEATURE_COMMENTS=true

# Leitor de áudio "Ouvir artigo" na barra lateral do artigo. Precisa de um fornecedor de TTS.
NEXT_PUBLIC_FEATURE_AUDIO=false

# Botões "Seguir categoria" na página do artigo.
NEXT_PUBLIC_FEATURE_TOPIC_FOLLOW=true

# Interruptor principal da área pública de leitores (/conta/*). O
# backend tem uma flag SEPARADA, FEATURE_READER_AREA, deliberadamente
# sem o prefixo NEXT_PUBLIC_: esta só esconde a interface, a API
# protege-se a si própria. As duas têm de estar ligadas para a
# funcionalidade trabalhar.
NEXT_PUBLIC_FEATURE_READER_AREA=true

# Links "Iniciar sessão" / "Criar conta" no topo, a apontar para /conta.
# /admin/login é um sistema de contas SEPARADO (equipa da redacção),
# fica apenas interno e é alcançado escrevendo o URL directamente.
NEXT_PUBLIC_FEATURE_PUBLIC_AUTH=true

# Mostra "Assinar agora" em vez da página que explica o que aí vem. Só
# controla a interface — quem decide se há cobrança é STRIPE_SECRET_KEY
# na API. Ligue as duas em conjunto: um botão que só produz erro é pior
# do que nenhum botão.
NEXT_PUBLIC_FEATURE_BILLING=false
