NODE_ENV=development
PORT=3005

# URL the browser uses to reach the API
NEXT_PUBLIC_API_URL=http://localhost:8585

# URL the Next.js server uses to reach the API (server-to-server inside the docker network)
INTERNAL_API_URL=http://api:8585

# ────────────────────────────────────────────────────────────────────────────
# Public feature flags. Leave empty/false unless the backing feature is ready.
# These are NEXT_PUBLIC_*: they are inlined into the client bundle, so do NOT
# use them for security boundaries. Always enforce permissions on the server.
# ────────────────────────────────────────────────────────────────────────────

# Comments engine (posting, moderation, "Mais Comentadas" tab). Requires a
# Comment model on the backend.
NEXT_PUBLIC_FEATURE_COMMENTS=false

# "Ouvir artigo" audio reader in the article sidebar. Requires a TTS provider.
NEXT_PUBLIC_FEATURE_AUDIO=false

# "Acompanhar tema" follow buttons. Requires reader accounts.
NEXT_PUBLIC_FEATURE_TOPIC_FOLLOW=false

# Master switch for the public reader area (/conta/*). The backend has a
# SEPARATE flag, FEATURE_READER_AREA, deliberately without the
# NEXT_PUBLIC_ prefix: this one only hides UI, the API gates itself.
# Both have to be on for the feature to work.
NEXT_PUBLIC_FEATURE_READER_AREA=false

# Top-bar "Iniciar sessao" / "Criar conta" links, pointing at /conta.
# /admin/login is a SEPARATE account system (newsroom staff), stays
# internal-only and is reachable by typing the URL.
NEXT_PUBLIC_FEATURE_PUBLIC_AUTH=false
