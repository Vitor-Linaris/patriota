generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  moduleFormat        = "cjs"
  runtime             = "nodejs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  EDITOR_CHEFE
  EDITOR
  JORNALISTA
  REVISOR
  MODERADOR
  ANALISTA
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  role      Role     @default(JORNALISTA)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities ActivityLog[]
}

model Category {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  description String     @default("")
  icon        String     @default("◆")
  color       String     @default("#1e40af")
  order       Int        @default(0)
  visible     Boolean    @default(true)
  subtopics   Subtopic[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Subtopic {
  id         String   @id @default(cuid())
  categoryId String
  label      String
  order      Int      @default(0)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
}

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String
  action      String
  targetType  String
  targetId    String?
  targetLabel String
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([userId, createdAt])
}

/// Per-role permission overrides. SUPER_ADMIN is always implicitly all.
/// `permissions` is the full set of permission keys granted to the role
/// (e.g. ["artigos.ler", "artigos.criar", ...]).
model RolePermissions {
  role        Role     @id
  permissions String[]
  updatedAt   DateTime @updatedAt
}
