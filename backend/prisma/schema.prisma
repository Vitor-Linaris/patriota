generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  moduleFormat        = "cjs"
  runtime             = "nodejs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  EDITOR_CHEFE
  EDITOR
  JORNALISTA
  REVISOR
  MODERADOR
  ANALISTA
}

enum ArticleStatus {
  RASCUNHO
  AGENDADO
  PUBLICADO
  ARQUIVADO
}

model Media {
  id           String   @id @default(cuid())
  url          String
  name         String
  mimeType     String?
  size         Int?
  width        Int?
  height       Int?
  uploadedById String?
  uploadedAt   DateTime @default(now())

  @@index([uploadedAt])
}

enum AdType {
  EMPTY
  IMAGE
  HTML
}

model Ad {
  id         String   @id
  name       String
  page       String
  position   String
  size       String
  sizeLabel  String
  type       AdType   @default(EMPTY)
  enabled    Boolean  @default(true)
  imageUrl   String?
  linkUrl    String?
  linkTarget String?
  altText    String?
  htmlCode   String?
  updatedAt  DateTime @updatedAt @default(now())

  @@index([page, enabled])
}

enum CampaignStatus {
  RASCUNHO
  AGENDADA
  ENVIADA
}

enum SubscriberStatus {
  ATIVO
  INATIVO
  CANCELADO
}

model NewsletterCampaign {
  id          String         @id @default(cuid())
  subject     String
  preview     String         @default("")
  segment     String         @default("Todos")
  header      String         @default("")
  body        String         @default("")
  ctaText     String         @default("")
  ctaUrl      String         @default("")
  footer      String         @default("")
  status      CampaignStatus @default(RASCUNHO)
  scheduledAt DateTime?
  sentAt      DateTime?
  recipients  Int            @default(0)
  opens       Int            @default(0)
  clicks      Int            @default(0)
  openRate    Float          @default(0)
  clickRate   Float          @default(0)
  createdAt   DateTime       @default(now())

  @@index([status, scheduledAt])
}

model NewsletterSubscriber {
  id       String           @id @default(cuid())
  email    String           @unique
  name     String           @default("")
  status   SubscriberStatus @default(ATIVO)
  segment  String           @default("Geral")
  opens    Int              @default(0)
  joinedAt DateTime         @default(now())

  @@index([status])
  @@index([segment])
}

model Setting {
  section   String   @id
  data      Json     @default("{}")
  updatedAt DateTime @updatedAt @default(now())
}

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  name              String?
  password          String
  role              Role     @default(JORNALISTA)
  isActive          Boolean  @default(true)
  bio               String?
  phone             String?
  avatarUrl         String?
  notificationPrefs Json     @default("{}")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  activities ActivityLog[]
  articles   Article[]
}

model Category {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  description String     @default("")
  icon        String     @default("◆")
  color       String     @default("#1e40af")
  order       Int        @default(0)
  visible     Boolean    @default(true)
  subtopics   Subtopic[]
  articles    Article[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Article {
  id              String        @id @default(cuid())
  slug            String        @unique
  title           String
  summary         String        @default("")
  content         String        @default("")
  status          ArticleStatus @default(RASCUNHO)
  premium         Boolean       @default(false)
  views           Int           @default(0)
  readMinutes     Int           @default(3)
  tags            String[]      @default([])
  metaTitle       String?
  metaDescription String?
  coverImageUrl   String?
  scheduledAt     DateTime?
  publishedAt     DateTime?
  categoryId      String
  authorId        String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  category Category @relation(fields: [categoryId], references: [id])
  author   User     @relation(fields: [authorId], references: [id])

  @@index([categoryId, status, publishedAt])
  @@index([status, publishedAt])
}

model Subtopic {
  id         String   @id @default(cuid())
  categoryId String
  label      String
  order      Int      @default(0)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
}

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String
  action      String
  targetType  String
  targetId    String?
  targetLabel String
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([userId, createdAt])
}

/// Per-role permission overrides. SUPER_ADMIN is always implicitly all.
/// `permissions` is the full set of permission keys granted to the role
/// (e.g. ["artigos.ler", "artigos.criar", ...]).
model RolePermissions {
  role        Role     @id
  permissions String[]
  updatedAt   DateTime @updatedAt
}
