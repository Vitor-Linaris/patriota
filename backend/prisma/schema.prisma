generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  moduleFormat        = "cjs"
  runtime             = "nodejs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  EDITOR_CHEFE
  EDITOR
  JORNALISTA
  REVISOR
  MODERADOR
  ANALISTA
}

enum ArticleStatus {
  RASCUNHO
  EM_REVISAO
  AGENDADO
  PUBLICADO
  ARQUIVADO
}

/// Reader accounts are the PUBLIC audience and share nothing with the User
/// model (newsroom staff, RBAC, /admin). Separate table, separate JWT
/// secret, separate cookie, separate guard - see src/reader-auth/.
enum ReaderStatus {
  PENDENTE_VERIFICACAO
  ATIVO
  SUSPENSO
  ANONIMIZADO
}

/// Where a subscription came from. Lets the dashboard tell a gift from
/// a paying customer, and stops a manual grant quietly overwriting a
/// live Stripe subscription.
enum PlanSource {
  MANUAL
  STRIPE
}

/// The reader's plan. No longer inert: the paywall reads it, though only
/// through the PlanPermissions table — what PREMIUM actually buys is a
/// question answered on /admin/permissions, not by this enum.
enum ReaderPlan {
  GRATIS
  PREMIUM
}

enum ReaderAuthProvider {
  GOOGLE
  FACEBOOK
}

enum CommentStatus {
  PENDENTE
  APROVADO
  REJEITADO
  SPAM
  ELIMINADO
}

enum EmailTokenType {
  VERIFICACAO_EMAIL
  REPOR_PASSWORD
}

enum DigestFrequency {
  IMEDIATO
  DIARIO
  SEMANAL
  NUNCA
}

enum NotificationStatus {
  PENDENTE
  ENVIADO
  FALHOU
}

/// Whether a file may be fetched by anyone with the address.
///
/// Media starts PRIVADO and becomes PUBLICO the moment it is used in
/// something published. That is not a preference — an article on the
/// site has to serve its images to readers with no session, to
/// Googlebot, and to whatever generates the preview when somebody
/// shares the link. None of those authenticate.
///
/// So the promise is narrower than "private files": an embargoed
/// photograph or a draft graphic is unreachable, and the moment the
/// piece runs, its images are public for good. See uploads serving in
/// src/media/.
enum MediaVisibility {
  PRIVADO
  PUBLICO
}

/// Image or video. The stored mime type cannot answer this on its own:
/// an image is always converted to WebP, while a video is stored in
/// whatever web-playable format it arrived in.
enum MediaKind {
  IMAGEM
  VIDEO
}

/// What a file is FOR, which decides whose problem it is.
///
/// EDITORIAL is the newsroom library: photographs for articles, kept so
/// they can be reused, and deleted only when nothing points at them.
///
/// PUBLICIDADE is a banner. It belongs to one ad slot, is replaced when
/// the campaign changes, and is of no use to anybody writing. It stays
/// out of the library entirely and is deleted outright from the ad
/// screen — a different rule from EDITORIAL, deliberately.
enum MediaPurpose {
  EDITORIAL
  PUBLICIDADE
}

model Media {
  id           String   @id @default(cuid())
  // Canonical URL — points to the "large" WebP variant for uploads,
  // or to the raw external URL for URL-paste entries.
  url          String
  urlMedium    String?
  urlSmall     String?
  name         String
  mimeType     String?
  size         Int?
  width        Int?
  height       Int?
  /// Frame count, on an animation. NULL on a still.
  ///
  /// Stored so the library can mark a GIF as animated without opening
  /// the file — the stored format is WebP either way, so the mime type
  /// cannot answer it.
  frames       Int?

  /// Everything this upload actually occupies: all three variants, not
  /// just the canonical one.
  ///
  /// Separate from `size` on purpose. `size` is what the library shows
  /// next to "Tamanho", and it has to match the file somebody would
  /// download; this is what the quota has to count, and counting only
  /// the large variant would undercount every upload by the other two —
  /// roughly a third of the disk, invisible.
  ///
  /// NULL on rows that predate the column and on pasted external URLs,
  /// which occupy nothing of ours.
  ///
  /// Int, not BigInt: one row holds ONE upload, which is capped well
  /// below the ~2.1 GB an Int reaches. The per-person total can exceed
  /// that safely — Postgres sums integers into a bigint.
  bytesOnDisk  Int?
  /// Who put this here. Written since the column existed but never read
  /// until the library became per-user — see media.service.ts.
  ///
  /// SetNull, never Cascade: deleting a member of staff must not delete
  /// the images their published articles still point at. The row
  /// outlives the account and falls back to the SUPER_ADMIN's view.
  uploadedById String?
  uploadedBy   User?    @relation("MediaUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedAt   DateTime @default(now())

  visibility   MediaVisibility @default(PRIVADO)

  /// Editorial library, or an ad banner. See MediaPurpose.
  ///
  /// Default EDITORIAL so every existing row, and anything uploaded by
  /// a path that does not know about this column, lands in the library
  /// — the safe direction. A file wrongly IN the library is visible and
  /// fixable; one wrongly outside it is invisible to everyone.
  purpose      MediaPurpose    @default(EDITORIAL)

  kind         MediaKind       @default(IMAGEM)
  /// Length in seconds, on a video. NULL on an image.
  durationSeconds Int?
  /// A still taken from the video, for the library grid and the picker.
  /// NULL when the frame could not be extracted — a worse-looking
  /// library, not a reason to refuse a working video.
  posterUrl    String?

  /// "YYYY/MM/<baseId>" — the three variants share it and differ only by
  /// suffix. NULL for pasted external URLs, which are not ours to serve.
  ///
  /// Exists so that serving a file is ONE indexed lookup. Without it,
  /// answering "which row owns /uploads/2026/09/abc-large.webp" would
  /// mean OR-ing three unindexed columns on every image request —
  /// a full table scan per image on every page of the newspaper.
  storageKey   String?         @unique

  @@index([uploadedAt])
  /// "my library, newest first" — the shape of every listing now that
  /// the library is scoped to one person. Without it that is a full
  /// table scan on every page load.
  @@index([uploadedById, uploadedAt])
  /// The quota sums bytesOnDisk per owner on every upload. Covering
  /// both columns lets Postgres answer it from the index alone.
  @@index([uploadedById, bytesOnDisk])
  /// Every library listing filters on purpose as well as owner now.
  @@index([purpose, uploadedById, uploadedAt])
}

enum AdType {
  EMPTY
  IMAGE
  HTML
}

model Ad {
  id         String   @id
  name       String
  page       String
  position   String
  size       String
  sizeLabel  String
  type       AdType   @default(EMPTY)
  enabled    Boolean  @default(true)
  imageUrl   String?
  linkUrl    String?
  linkTarget String?
  altText    String?
  htmlCode   String?
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([page, enabled])
}

enum CampaignStatus {
  RASCUNHO
  AGENDADA
  ENVIADA
}

enum SubscriberStatus {
  ATIVO
  INATIVO
  CANCELADO
}

model NewsletterCampaign {
  id          String         @id @default(cuid())
  subject     String
  preview     String         @default("")
  segment     String         @default("Todos")
  header      String         @default("")
  body        String         @default("")
  ctaText     String         @default("")
  ctaUrl      String         @default("")
  footer      String         @default("")
  status      CampaignStatus @default(RASCUNHO)
  scheduledAt DateTime?
  sentAt      DateTime?
  recipients  Int            @default(0)
  opens       Int            @default(0)
  clicks      Int            @default(0)
  openRate    Float          @default(0)
  clickRate   Float          @default(0)
  createdAt   DateTime       @default(now())

  @@index([status, scheduledAt])
}

model NewsletterSubscriber {
  id       String           @id @default(cuid())
  email    String           @unique
  name     String           @default("")
  status   SubscriberStatus @default(ATIVO)
  segment  String           @default("Geral")
  opens    Int              @default(0)
  joinedAt DateTime         @default(now())

  @@index([status])
  @@index([segment])
}

model Setting {
  section   String   @id
  data      Json     @default("{}")
  updatedAt DateTime @default(now()) @updatedAt
}

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  name              String?
  password          String
  role              Role     @default(JORNALISTA)
  isActive          Boolean  @default(true)
  bio               String?
  phone             String?
  avatarUrl         String?
  notificationPrefs Json     @default("{}")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  activities        ActivityLog[]
  articles          Article[]
  moderatedComments Comment[]     @relation("CommentModerator")
  suspendedReaders  Reader[]      @relation("ReaderSuspender")
  grantedPlans      Reader[]      @relation("PlanGranter")
  media             Media[]       @relation("MediaUploader")
}

/// Up to 4 levels: categoria (depth 0) -> subcategoria -> topico ->
/// subtopico (depth 3). Enforced by the CHECK below AND in
/// CategoryTreeService, because the "does this move fit" rule needs the
/// parent row, which a DB constraint alone can't see for a whole subtree
/// move.
///
/// path is materialised ("/<ancestorId>/.../<id>/", self-inclusive) so a
/// subtree is `startsWith(path)` in memory against a cached tree, never a
/// recursive query — Prisma 7 has no native recursive CTE, and this tree
/// is small enough (a few hundred nodes at most) that a closure table
/// would only add write-side bookkeeping for nothing gained.
model Category {
  id          String             @id @default(cuid())
  /// Globally unique regardless of depth, and deliberately so — see the
  /// note on parentId. slugify() disambiguates collisions at creation
  /// time (economia -> economia-mundo -> economia-2) rather than scoping
  /// uniqueness to a parent.
  slug        String             @unique
  name        String
  description String             @default("")
  icon        String             @default("◆")
  color       String             @default("#1e40af")
  /// Sibling order — renumbered densely within one parent on every
  /// create, delete and reorder. NOT a global order across the tree.
  order       Int                @default(0)
  visible     Boolean            @default(true)
  /// Whether readers are OFFERED this category to follow.
  ///
  /// Separate from `visible`, which decides the public menu. The two ask
  /// different questions: `visible` is "does this section exist on the
  /// site", and this is "do we invite people to subscribe to it by
  /// e-mail". A section can be live and still not be something the
  /// newsroom wants to promise a mail about — a category being tried
  /// out, or one that will be renamed next week.
  ///
  /// Default FALSE, which is the opposite of `visible` and deliberate: a
  /// category just created is usually still being decided on, and it
  /// appearing in every reader's follow list the moment somebody typed a
  /// name is the mistake this prevents. It is turned on when the section
  /// is ready to be promoted.
  ///
  /// Existing follows are NOT broken by turning this off — see
  /// reader-library.service.ts. Silently unsubscribing people is worse
  /// than leaving a stale follow in place.
  followable  Boolean            @default(false)
  articles    Article[]
  favorites   CategoryFavorite[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  /// Restrict, not Cascade: deleting a category with children must be a
  /// deliberate choice made through the service (which the reorder/move
  /// endpoint also uses to re-home a subtree), never an accidental
  /// cascade wiping out a whole branch.
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")
  path     String
  depth    Int        @default(0)

  @@index([parentId, order])
  @@index([path])
}

model Article {
  id                    String        @id @default(cuid())
  slug                  String        @unique
  title                 String
  summary               String        @default("")
  content               String        @default("")
  status                ArticleStatus @default(RASCUNHO)
  /// Requires a paid subscription to read. Named `premium` until the
  /// subscription model was decided; the reader-facing word is now
  /// "exclusivo", and Reader.plan (GRATIS | PREMIUM) is the SEPARATE
  /// concept of whether a given reader pays.
  exclusive             Boolean       @default(false)
  views                 Int           @default(0)
  readMinutes           Int           @default(3)
  tags                  String[]      @default([])
  essentials            String[]      @default([])
  context               Json?
  pullQuote             Json?
  metaTitle             String?
  metaDescription       String?
  coverImageUrl         String?
  /// A partner's video page, or a direct file URL — embedded below the
  /// cover image on the article page. See VideoEmbed.tsx (frontend) for
  /// how the shape of the URL decides how it gets played.
  videoEmbedUrl         String?
  scheduledAt           DateTime?
  publishedAt           DateTime?
  rejectionReason       String?
  /// Denormalised count of APROVADO comments. Kept in sync by
  /// CommentsService so "Mais comentadas" is an indexed orderBy rather
  /// than a groupBy join on every article listing.
  commentCount          Int           @default(0)
  /// Claim flag for the notification fan-out. NULL means not yet queued.
  /// A poller keys off this instead of hooking the publish path, because
  /// an article can reach PUBLICADO through four different code paths:
  /// publish(), the scheduler cron, create() and update().
  /// NOTE: the migration backfills this to now() for every already
  /// published article - without that the first cron tick would email
  /// the entire archive to every reader.
  notificationsQueuedAt DateTime?
  /// Edits made to an article that is ALREADY LIVE, held aside instead of
  /// applied.
  ///
  /// The columns above keep serving readers untouched while this fills
  /// up, so correcting a typo on a published piece never takes it off
  /// the site — not even if the journalist wanders off mid-sentence and
  /// the autosave is the only thing that ran. Promoting this into the
  /// real columns is an explicit act (publish), never a side effect of
  /// typing.
  ///
  /// A JSON blob rather than a parallel set of draft* columns: the
  /// editable payload is ~14 fields and would double the width of this
  /// model for something never queried by field, only read whole.
  /// NULL means "what you see is what is live".
  draft                 Json?
  draftUpdatedAt        DateTime?
  /// True when the pending edit came from someone without
  /// artigos.publicar — it needs an approver before it can replace what
  /// the public sees.
  draftAwaitingReview   Boolean       @default(false)
  categoryId            String
  authorId              String
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  category       Category              @relation(fields: [categoryId], references: [id])
  author         User                  @relation(fields: [authorId], references: [id])
  comments       Comment[]
  favorites      ArticleFavorite[]
  readingEntries ReadingHistory[]
  notifications  ArticleNotification[]

  @@index([categoryId, status, publishedAt])
  @@index([status, publishedAt])
  @@index([status, notificationsQueuedAt])
  /// The approval queue asks for these on every load.
  @@index([draftAwaitingReview])
}

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String
  action      String
  targetType  String
  targetId    String?
  targetLabel String
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([userId, createdAt])
}

/// Per-role permission overrides. SUPER_ADMIN is always implicitly all.
/// `permissions` is the full set of permission keys granted to the role
/// (e.g. ["artigos.ler", "artigos.criar", ...]).
model RolePermissions {
  role        Role     @id
  permissions String[]
  updatedAt   DateTime @updatedAt
}

/// What a reader on each plan may do. Mirrors RolePermissions, and is a
/// separate table on purpose: a reader's plan is not a Role, and folding
/// the two lists together would let a staff role be granted a reader
/// permission by accident. See the note in rbac.constants.ts.
/// Every Stripe event we have already acted on.
///
/// Stripe retries a webhook until it gets a 2xx, and it sends the same
/// event more than once by design — "at least once" delivery. Handling
/// one twice must not extend a subscription twice, so the id goes in
/// here first, inside the same transaction as the change it authorises.
/// The primary key is Stripe's own event id, which makes the second
/// delivery a unique-constraint violation rather than a judgement call.
///
/// Rows are never updated. Old ones can be pruned by date if this ever
/// grows enough to matter.
model StripeEvent {
  /// Stripe's `evt_…` id.
  id         String   @id
  type       String
  /// Which reader it touched, when we could tell. For support, not logic.
  readerId   String?
  receivedAt DateTime @default(now())

  @@index([receivedAt])
}

model PlanPermissions {
  plan        ReaderPlan @id
  permissions String[]
  updatedAt   DateTime   @updatedAt
}

// ─────────────────────────────────────────────────────────────────────
// Reader area — the PUBLIC audience.
//
// Deliberately disjoint from User/Role/RolePermissions above, which model
// newsroom staff. A Reader has no role and never touches RBAC; a User can
// never authenticate against these tables. See src/reader-auth/ for the
// four isolation layers (distinct secret, typ claim, distinct table,
// distinct request property).
// ─────────────────────────────────────────────────────────────────────

model Reader {
  id              String       @id @default(cuid())
  email           String       @unique
  emailVerifiedAt DateTime?
  /// NULL for accounts created through Google/Facebook only. Login must
  /// reject a null password BEFORE bcrypt.compare, while still burning a
  /// dummy compare, or "is this account social-only?" becomes a timing
  /// oracle. bcrypt cost 12, matching users.service.ts.
  password        String?
  name            String?
  avatarUrl       String?
  status          ReaderStatus @default(PENDENTE_VERIFICACAO)
  /// Bumped on password change/reset and on "terminar todas as sessoes".
  /// Tokens carry it as tv; a mismatch fails the guard, which is how a
  /// 30-day cookie gets revoked without server-side session storage.
  tokenVersion    Int          @default(0)

  /// Suspension detail. `status = SUSPENSO` is the flag; this is the rest
  /// of the story. A NULL `suspendedUntil` alongside SUSPENSO means
  /// permanent; a date in the future is a ban that LAPSES ON ITS OWN,
  /// because every checkpoint compares the date instead of trusting a
  /// scheduled job to come along and flip the status back. If the process
  /// is down on the day a ban ends, nobody stays banned by accident.
  /// reader-suspension.ts is the single place that decides.
  suspendedUntil   DateTime?
  suspensionReason String?
  suspendedById    String?
  suspendedBy      User?     @relation("ReaderSuspender", fields: [suspendedById], references: [id], onDelete: SetNull)

  // Notification preferences (global; per-category lives on CategoryFavorite)
  notifyNewArticles Boolean         @default(true)
  /// IMEDIATO, not DIARIO. There is no UI anywhere for a reader to pick a
  /// cadence — /conta/categorias offers a per-category "E-mails" tick and
  /// nothing else — so this default is not one reader ever chose, it is
  /// simply what everybody gets. Defaulting to the 08:00 daily digest meant
  /// somebody who ticked "avisem-me" the moment a piece went out heard
  /// nothing until the next morning, which reads as broken rather than as
  /// a setting. IMEDIATO still batches (see the immediate tick in
  /// reader-notifications.scheduler.ts) so a burst of publishing is one
  /// e-mail, not one per article.
  digestFrequency   DigestFrequency @default(IMEDIATO)
  /// One-click unsubscribe secret for the RFC 8058 List-Unsubscribe header,
  /// which must work with no session and no CSRF token. NO @default here on
  /// purpose: cuid is sequential enough to guess. The service generates it
  /// with randomBytes(32).
  unsubscribeToken  String          @unique

  /// When false the reader shows as "Leitor" on their public comments.
  displayNamePublic Boolean @default(true)

  plan       ReaderPlan @default(GRATIS)
  planStatus String?
  /// When the current entitlement ENDS. NULL means no end date.
  ///
  /// One column for both kinds of subscription, and one meaning:
  /// "entitled until". For Stripe that is the end of the paid period —
  /// which is also why a cancelled subscription keeps working to the
  /// date it was paid up to. For a subscription given by hand it is the
  /// expiry the admin chose.
  ///
  /// Read by date, like a suspension: a lapsed plan reads as GRATIS at
  /// the next request, with no job to run. See reader-entitlement.ts.
  planRenewsAt     DateTime?
  /// When the current subscription BEGAN.
  ///
  /// Needed to answer "how many new subscribers this month", which no
  /// other column can: planRenewsAt moves forward on every renewal, and
  /// createdAt is when the account was opened, not when they started
  /// paying.
  planStartedAt    DateTime?
  /// Whether the current period is the LAST one.
  ///
  /// `planRenewsAt` alone cannot answer this. It means "entitled until",
  /// and a cancelled Stripe subscription keeps that date exactly as it
  /// was — Stripe leaves the status `active` and only sets
  /// `cancel_at_period_end`. So a reader who had just cancelled was
  /// being told "Renova a 2 de outubro", which is the opposite of what
  /// they had asked for.
  ///
  /// True also for a subscription given by hand, which never renews.
  /// One column, one question — "does this date mean renewal or the
  /// end?" — answered the same way whatever the source.
  planCancelAtPeriodEnd Boolean @default(false)
  /// When the cancellation was REQUESTED, not when access stops.
  ///
  /// Access stops at `planRenewsAt`; this is the day the reader clicked
  /// cancel, which is the one the newsroom needs to see churn as it
  /// happens rather than a month later when the period runs out.
  planCanceledAt   DateTime?
  /// Where the subscription came from. NULL on a free reader.
  planSource       PlanSource?
  /// Who gave it, on a manual grant. Kept so a gift has a name attached.
  planGrantedById  String?
  planGrantedBy    User?       @relation("PlanGranter", fields: [planGrantedById], references: [id], onDelete: SetNull)
  /// Why it was given. Internal; the reader never sees it.
  planNote         String?
  /// The Stripe customer. Kept even after a subscription ends — they are
  /// still the same customer, and losing it would orphan their invoice
  /// history and mint a second customer if they ever come back.
  stripeCustomerId String?     @unique
  /// The Stripe subscription currently backing this plan, if any.
  stripeSubscriptionId String? @unique

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  identities        ReaderIdentity[]
  categoryFavorites CategoryFavorite[]
  articleFavorites  ArticleFavorite[]
  comments          Comment[]
  readingHistory    ReadingHistory[]
  emailTokens       EmailToken[]
  notifications     ArticleNotification[]

  @@index([status])
  @@index([createdAt])
  /// Counting live subscribers is "plan = PREMIUM AND the end date has
  /// not passed" — the shape of every subscription figure on the
  /// dashboard. Without this it is a full table scan on every load.
  @@index([plan, planRenewsAt])
  /// "Who cancelled recently" — the churn figure on the dashboard and
  /// the list behind it. Sorted and filtered by the same column.
  @@index([planCanceledAt])
  /// Both of these exist in the database already, created by hand in the
  /// migrations that added the foreign keys. Declared here so the schema
  /// and the database agree — undeclared, the next `migrate dev` would
  /// generate a migration to drop them.
  @@index([suspendedById])
  @@index([planGrantedById])
}

/// A linked social account. One Reader may hold several.
///
/// Linking rules (account-takeover surface, enforced in the service):
///   - Google: auto-link to an existing Reader with the same address only
///     when the provider asserts email_verified AND the local row already
///     has emailVerifiedAt set.
///   - Facebook: never auto-link onto an account that has a password.
///     Facebook has historically returned addresses it had not verified.
model ReaderIdentity {
  id                String             @id @default(cuid())
  readerId          String
  provider          ReaderAuthProvider
  providerAccountId String
  email             String?
  createdAt         DateTime           @default(now())

  reader Reader @relation(fields: [readerId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([readerId])
}

/// "Seguir esta categoria". notify is the per-category email mute and is
/// deliberately NOT the same as removing the favourite - a reader may want
/// the category on their dashboard without the emails.
model CategoryFavorite {
  readerId   String
  categoryId String
  notify     Boolean  @default(true)
  createdAt  DateTime @default(now())

  reader   Reader   @relation(fields: [readerId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([readerId, categoryId])
  /// The notification fan-out query runs on exactly this index.
  @@index([categoryId, notify])
}

model ArticleFavorite {
  readerId  String
  articleId String
  createdAt DateTime @default(now())

  reader  Reader  @relation(fields: [readerId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([readerId, articleId])
  @@index([readerId, createdAt])
  @@index([articleId])
}

/// Authored by a Reader only. Staff appear solely on the moderation
/// columns - a nullable author FK pointing at two tables would poison
/// every query and every include for a feature nobody has asked for.
/// Letting staff reply inline later is a purely additive migration.
model Comment {
  id        String        @id @default(cuid())
  articleId String
  readerId  String
  /// Threads are capped at two levels: the service re-parents a reply to a
  /// reply onto the root rather than rejecting it.
  parentId  String?
  /// PLAIN TEXT. Tags are stripped on write and it renders as {body} in
  /// JSX - never dangerouslySetInnerHTML, whatever the article body does.
  body      String
  status    CommentStatus @default(PENDENTE)
  editedAt  DateTime?

  moderatedById  String?
  moderatedAt    DateTime?
  moderationNote String?

  reportCount Int     @default(0)
  /// Daily-salted SHA-256, same scheme as the visitor hash in proxy.ts:
  /// an abuse signal that stops being personal data after 24h.
  ipHash      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  article     Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  reader      Reader    @relation(fields: [readerId], references: [id], onDelete: Cascade)
  parent      Comment?  @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies     Comment[] @relation("CommentThread")
  moderatedBy User?     @relation("CommentModerator", fields: [moderatedById], references: [id], onDelete: SetNull)

  /// Public thread render.
  @@index([articleId, status, createdAt])
  /// The /admin/comentarios moderation queue.
  @@index([status, createdAt])
  /// "Em que noticias comentei" on the reader dashboard.
  @@index([readerId, createdAt])
  @@index([parentId])
}

/// One row per (reader, article) pair, upserted on each view rather than an
/// append-only event log: bounded size, and the history page becomes a
/// single indexed scan. readCount recovers the "read it twice" signal.
model ReadingHistory {
  id         String   @id @default(cuid())
  readerId   String
  articleId  String
  lastReadAt DateTime @default(now())
  readCount  Int      @default(1)
  /// Scroll depth 0-100, best effort.
  progress   Int      @default(0)

  reader  Reader  @relation(fields: [readerId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([readerId, articleId])
  @@index([readerId, lastReadAt(sort: Desc)])
}

/// Email verification and password reset.
///
/// Stores sha256(token) only - the raw value exists in the email and
/// nowhere else. Single use (usedAt). A successful reset also deletes the
/// other outstanding REPOR_PASSWORD rows for that reader and bumps
/// tokenVersion, which kills every live session.
///
/// Postgres rather than Redis (which is already wired up) because these
/// must survive a cache flush and stay auditable.
model EmailToken {
  id        String         @id @default(cuid())
  readerId  String
  type      EmailTokenType
  tokenHash String         @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime       @default(now())

  reader Reader @relation(fields: [readerId], references: [id], onDelete: Cascade)

  @@index([readerId, type])
  @@index([expiresAt])
}

/// Outbox for "new article in a category you follow".
///
/// The @@unique IS the deduplication: enqueue is a createMany with
/// skipDuplicates, so re-running the poller, restarting the container or
/// running two API instances all converge on one row per reader/article.
model ArticleNotification {
  id        String             @id @default(cuid())
  readerId  String
  articleId String
  status    NotificationStatus @default(PENDENTE)
  attempts  Int                @default(0)
  lastError String?
  createdAt DateTime           @default(now())
  sentAt    DateTime?

  reader  Reader  @relation(fields: [readerId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([readerId, articleId])
  @@index([status, createdAt])
  @@index([articleId])
}
