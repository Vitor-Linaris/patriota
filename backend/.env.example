NODE_ENV=development
PORT=3000

# Postgres — change these before any non-local use
POSTGRES_USER=change_me
POSTGRES_PASSWORD=change_me
POSTGRES_DB=change_me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

DATABASE_URL="postgresql://change_me:change_me@postgres:5432/change_me?schema=public"

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL="redis://redis:6379"

# Auth — MUST change for any non-local environment
JWT_SECRET=change_me_long_random_string
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:3005

# Superadmin seed — change these
SUPERADMIN_EMAIL=admin@opatriota.pt
SUPERADMIN_PASSWORD=change_me_strong_password
SUPERADMIN_NAME=Super Admin
