NODE_ENV=development
PORT=3000

# Postgres — change these before any non-local use
POSTGRES_USER=change_me
POSTGRES_PASSWORD=change_me
POSTGRES_DB=change_me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

DATABASE_URL="postgresql://change_me:change_me@postgres:5432/change_me?schema=public"

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL="redis://redis:6379"

# Auth — REQUIRED, must be 32+ chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=generate_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=8h

# CORS — required in production. Comma-separated list of allowed origins.
# Dev defaults to http://localhost:3005 when unset.
CORS_ORIGIN=http://localhost:3005

# Superadmin seed — change these
SUPERADMIN_EMAIL=admin@opatriota.pt
SUPERADMIN_PASSWORD=change_me_strong_password
SUPERADMIN_NAME=Super Admin

# Media uploads — local disk via Docker named volume.
UPLOADS_DIR=/usr/src/app/uploads
UPLOADS_PUBLIC_BASE_URL=http://localhost:8585/uploads

# Sharp image processing. Quality 80 hits a good size/visual sweet spot
# for WebP. Widths control the three generated variants.
IMAGE_QUALITY=80
IMAGE_SIZE_SMALL=400
IMAGE_SIZE_MEDIUM=800
IMAGE_SIZE_LARGE=1600
# Hard limit on the raw upload buffer (pre-resize). 10 MB.
MEDIA_MAX_UPLOAD_BYTES=10485760
