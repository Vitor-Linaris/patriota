NODE_ENV=development
PORT=3000

# Postgres — mude estes valores antes de qualquer uso fora do local
POSTGRES_USER=change_me
POSTGRES_PASSWORD=change_me
POSTGRES_DB=change_me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

DATABASE_URL="postgresql://change_me:change_me@postgres:5432/change_me?schema=public"

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL="redis://redis:6379"

# Auth — OBRIGATÓRIO, tem de ter 32+ caracteres. Gerar com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=generate_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=8h

# CORS — obrigatório em produção. Lista de origens permitidas, separadas por vírgula.
# Em desenvolvimento assume http://localhost:3005 quando não definido.
CORS_ORIGIN=http://localhost:3005

# Semente do superadmin — mude estes valores
SUPERADMIN_EMAIL=admin@opatriota.pt
SUPERADMIN_PASSWORD=change_me_strong_password
SUPERADMIN_NAME=Super Admin

# Upload de média — disco local via volume nomeado do Docker.
UPLOADS_DIR=/usr/src/app/uploads
UPLOADS_PUBLIC_BASE_URL=http://localhost:8585/uploads

# Processamento de imagem com Sharp. Qualidade 80 é um bom equilíbrio
# entre tamanho e aspecto visual para WebP. As larguras controlam as
# três variantes geradas.
IMAGE_QUALITY=80
IMAGE_SIZE_SMALL=400
IMAGE_SIZE_MEDIUM=800
IMAGE_SIZE_LARGE=1600
# Limite rígido do buffer de upload em bruto (antes de redimensionar). 10 MB.
MEDIA_MAX_UPLOAD_BYTES=10485760

# ── Área de leitores (público geral) ──────────────────────────────────
# Interruptor do lado do servidor. As flags NEXT_PUBLIC_FEATURE_* do
# frontend são embutidas no pacote do browser e não protegem nada — a
# API responde directamente em :8585 — por isso esta não tem prefixo
# NEXT_PUBLIC_ e toda a rota de leitores devolve 404 enquanto não for
# exactamente "true".
#
# Vem LIGADA desde o M10: a área de leitores está completa. Ponha a
# false para fechar a funcionalidade inteira (registo, login,
# comentários, favoritos, resumos por e-mail) sem precisar de um deploy.
FEATURE_READER_AREA=true

# Chave de assinatura das sessões de leitor. TEM de ter pelo menos 32
# caracteres e TEM de ser diferente de JWT_SECRET — a aplicação recusa
# arrancar caso contrário. Dois segredos separados significam que um
# esquecimento na verificação da audiência falha a verificação da
# assinatura em vez de deixar silenciosamente um token de leitor
# autorizar uma rota de equipa.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
READER_JWT_SECRET=change_me_to_a_different_long_random_string_min_32_chars
# Os leitores têm uma sessão longa; a revogação é feita por
# Reader.tokenVersion, não por expiração (mudança de password,
# recuperação, "terminar todas as sessões").
READER_JWT_EXPIRES_IN=30d

# ── Categorias hierárquicas ──────────────────────────────────────────
# O afunilamento: abrir "Portugal" mostra também os artigos publicados
# no Funchal e na Sé. A hierarquia em si (árvore no admin, arrastar,
# breadcrumbs) NÃO depende desta flag — só a filtragem depende.
#
# Ligado por omissão. Ponha 0 (ou false) para voltar ao comportamento
# antigo — cada categoria mostra apenas os seus próprios artigos — sem
# precisar de um deploy. A listagem do CMS nunca afunila por omissão:
# é preciso ?includeDescendants=true.
CATEGORY_FUNNEL=1

# ── E-mail transaccional ──────────────────────────────────────────────
# log    → escreve as mensagens no log da aplicação (por omissão; um
#          clone novo e a suite e2e funcionam ambos sem credenciais)
# brevo  → API transaccional do Brevo, precisa de BREVO_API_KEY. É o
#          fornecedor em uso. O endereço de origem tem de estar
#          verificado no Brevo, senão o envio é recusado.
# resend → API transaccional da Resend, precisa de RESEND_API_KEY.
#          Mantido como alternativa; não está em uso.
# smtp   → nodemailer, host/porta/utilizador vêm de
#          /admin/configuracoes › Email, a password vem de
#          SMTP_PASSWORD abaixo. Serve para qualquer servidor SMTP,
#          incluindo o relay do próprio Brevo (smtp-relay.brevo.com:587)
#          se um dia a saída por HTTP estiver bloqueada.
MAIL_DRIVER=log

# As credenciais são só de variáveis de ambiente, NUNCA em Setting:
# GET /admin/settings devolve esse JSON inteiro a quem tiver
# configuracoes.aceder.
#
# Brevo: painel → o seu nome (canto superior direito) → SMTP & API →
# separador "API Keys" → Generate a new API key. A chave começa por
# "xkeysib-". Antes de enviar seja o que for, verifique o remetente em
# Senders, Domains & Dedicated IPs → Senders.
BREVO_API_KEY=
RESEND_API_KEY=
SMTP_PASSWORD=

# Remetente de recurso quando a linha de Setting ainda não foi preenchida.
MAIL_FROM_NAME=O Patriota Notícias
MAIL_FROM_EMAIL=noreply@opatriota.pt

# Base absoluta para os links dentro dos e-mails (verificação, reposição
# de password, cancelar subscrição). NÃO é CORS_ORIGIN — essa é uma
# lista separada por vírgulas.
PUBLIC_SITE_URL=http://localhost:3005

# ── Login social dos leitores (M9) ───────────────────────────────────
# Deixe EM BRANCO para desligar um fornecedor:
# GET /public/reader/auth/providers só reporta os que estão
# configurados, e a página de login desenha os botões a partir dessa
# lista. Um fornecedor por configurar devolve 404, não 500.
#
# Google — Google Cloud Console › APIs & Services › Credentials ›
# OAuth 2.0 Client ID (Web application). Não precisa de revisão para os
# âmbitos básicos email/profile.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8585/public/reader/auth/google/callback

# Facebook — Meta for Developers › a sua app › Facebook Login.
# Pedir o âmbito `email` em PRODUÇÃO exige App Review da Meta, que
# demora dias. Em modo de desenvolvimento funciona de imediato, mas só
# para contas listadas como testers na app.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:8585/public/reader/auth/facebook/callback

# Para onde o callback do fornecedor envia o browser a seguir, levando
# um CÓDIGO DE UMA ÚNICA VEZ (nunca o token de sessão — um JWT num URL
# de redireccionamento fica no histórico do browser, nos cabeçalhos
# Referer e em todos os logs de proxy pelo caminho).
OAUTH_SUCCESS_REDIRECT=http://localhost:3005/conta/oauth

# ── Paywall ──────────────────────────────────────────────────────────
# Decide se um artigo marcado "Conteúdo Exclusivo" é mesmo retido de
# quem não é assinante. DESLIGADO a menos que seja exactamente "true",
# o oposto de CATEGORY_FUNNEL e de propósito: um afunilamento que falha
# aberto mostra mais artigos a um leitor, um paywall que falha aberto
# oferece o produto de graça. Retirar texto que as pessoas já liam de
# graça é uma decisão que se toma de propósito, no dia em que se
# pretende mesmo fazê-lo.
#
# O que uma assinatura compra de facto NÃO se decide aqui — é a linha
# `assinantes.ler_exclusivos` em /admin/permissions. Esta flag só decide
# se essa tabela chega a ser consultada.
FEATURE_PAYWALL=false

# ── Stripe (assinaturas pagas) ───────────────────────────────────────
# A PRESENÇA de STRIPE_SECRET_KEY é o interruptor: sem ela este servidor
# não cobra a ninguém, o webhook responde 200 a dizer que ignorou, e o
# checkout devolve 503. Não há flag à parte de propósito — uma flag que
# pode discordar da configuração é a forma de ter um servidor que julga
# que sabe cobrar e não sabe.
#
# NUNCA em Setting: o GET /admin/settings devolve o JSON inteiro a quem
# tiver configuracoes.aceder, e isto move dinheiro.
#
# Onde buscar, no painel do Stripe (comece em modo de TESTE):
#   Developers → API keys → Secret key          → STRIPE_SECRET_KEY
#   Developers → Webhooks → add endpoint        → STRIPE_WEBHOOK_SECRET
#     URL: https://<dominio>/public/stripe/webhook
#     Eventos: checkout.session.completed,
#              customer.subscription.created,
#              customer.subscription.updated,
#              customer.subscription.deleted
#   Product catalogue → o preço recorrente → id → STRIPE_PRICE_ID
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
