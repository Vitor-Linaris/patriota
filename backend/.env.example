NODE_ENV=development
PORT=3000

# Postgres — change these before any non-local use
POSTGRES_USER=change_me
POSTGRES_PASSWORD=change_me
POSTGRES_DB=change_me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

DATABASE_URL="postgresql://change_me:change_me@postgres:5432/change_me?schema=public"

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL="redis://redis:6379"

# Auth — REQUIRED, must be 32+ chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=generate_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=8h

# CORS — required in production. Comma-separated list of allowed origins.
# Dev defaults to http://localhost:3005 when unset.
CORS_ORIGIN=http://localhost:3005

# Superadmin seed — change these
SUPERADMIN_EMAIL=admin@opatriota.pt
SUPERADMIN_PASSWORD=change_me_strong_password
SUPERADMIN_NAME=Super Admin

# Media uploads — local disk via Docker named volume.
UPLOADS_DIR=/usr/src/app/uploads
UPLOADS_PUBLIC_BASE_URL=http://localhost:8585/uploads

# Sharp image processing. Quality 80 hits a good size/visual sweet spot
# for WebP. Widths control the three generated variants.
IMAGE_QUALITY=80
IMAGE_SIZE_SMALL=400
IMAGE_SIZE_MEDIUM=800
IMAGE_SIZE_LARGE=1600
# Hard limit on the raw upload buffer (pre-resize). 10 MB.
MEDIA_MAX_UPLOAD_BYTES=10485760

# ── Reader area (public audience) ────────────────────────────────────
# Server-side kill switch. The frontend NEXT_PUBLIC_FEATURE_* flags are
# inlined into the browser bundle and protect nothing — the API answers
# on :8585 directly — so this one has NO NEXT_PUBLIC_ prefix and every
# reader route 404s while it is not exactly "true".
FEATURE_READER_AREA=false

# Signing key for reader sessions. MUST be at least 32 chars and MUST NOT
# equal JWT_SECRET — the app refuses to boot otherwise. Two secrets mean a
# forgotten audience check fails signature verification rather than
# silently letting a reader token authorise a staff route.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
READER_JWT_SECRET=change_me_to_a_different_long_random_string_min_32_chars
# Readers get a long session; revocation is via Reader.tokenVersion, not
# expiry (password change / reset / "terminar todas as sessões").
READER_JWT_EXPIRES_IN=30d

# ── Transactional e-mail ─────────────────────────────────────────────
# log    → writes messages to the application log (default; a fresh clone
#          and the e2e suite both work with no credentials)
# resend → Resend transactional API, needs RESEND_API_KEY. The from
#          address must be on a domain verified in Resend, or every send
#          comes back 403.
# smtp   → nodemailer, host/port/user from /admin/configuracoes › Email,
#          password from SMTP_PASSWORD below
MAIL_DRIVER=log

# Credentials are env-only, NEVER Setting rows: GET /admin/settings
# returns that whole JSON blob to anyone with configuracoes.aceder.
RESEND_API_KEY=
SMTP_PASSWORD=

# Fallback sender when the Setting row has not been filled in.
MAIL_FROM_NAME=O Patriota Notícias
MAIL_FROM_EMAIL=noreply@opatriota.pt

# Absolute base for the links inside e-mails (verification, reset,
# unsubscribe). NOT CORS_ORIGIN — that one is a comma-separated list.
PUBLIC_SITE_URL=http://localhost:3005

# ── Login social dos leitores (M9) ───────────────────────────────────
# Leave BLANK to disable a provider: GET /public/reader/auth/providers
# reports only the configured ones, and the login page renders buttons
# from that list. Unconfigured providers 404 rather than 500.
#
# Google — Google Cloud Console › APIs & Services › Credentials ›
# OAuth 2.0 Client ID (Web application). No review needed for the basic
# email/profile scopes.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8585/public/reader/auth/google/callback

# Facebook — Meta for Developers › your app › Facebook Login.
# Requesting the `email` scope in PRODUCTION requires Meta's App Review,
# which takes days. In development mode it works immediately, but only
# for accounts listed as testers on the app.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:8585/public/reader/auth/facebook/callback

# Where the provider callback sends the browser afterwards, carrying a
# ONE-TIME CODE (never the session token — a JWT in a redirect URL lands
# in browser history, in Referer headers and in every proxy log).
OAUTH_SUCCESS_REDIRECT=http://localhost:3005/conta/oauth
